# Secrets must never enter a build context, even if no Dockerfile copies them.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Not needed to build a Go binary.
.git/
.github/
app/
docs/
deploy/
bin/
dist/
data/archive/
data/raw/
*.md

# A prompt is a .md file that a binary embeds, which makes it source code
# rather than prose. Excluding one fails the build with "contains no
# embeddable files" — a confusing way to find that out, and it has now
# happened twice: once for the classifier, once for internal/polish. So the
# exception is written for any package's prompts directory rather than named
# package by package, and the next one needs no edit here.
!internal/*/prompts/
!internal/*/prompts/*.md
