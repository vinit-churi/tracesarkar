# Phase 0 configuration. Copy to .env and fill in. .env is gitignored; never
# commit real values, and never paste them into an issue or a chat.

# --- Object storage (Cloudflare R2, S3-compatible) -------------------------
# The bucket URL may include the bucket path; the endpoint is derived from it.
R2_BUCKET_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=tracesarkar
R2_ACCESS_KEY=
R2_SECRET_ACCESS_KEY=

# --- Database (PostgreSQL 16; Aiven in Phase 0) ----------------------------
POSTGRESQL_CONNECTION=postgres://user:password@host:port/defaultdb?sslmode=require
# Path to the CA certificate. A relative path is resolved against this file's
# directory. Setting it upgrades the connection to sslmode=verify-full.
POSTGRES_CA_PATH=./ca.pem
# The same certificate inline, for platforms that can only pass environment
# variables and cannot mount a file (Dokploy). Raw PEM or base64 of one; base64
# avoids a multi-line value crossing two .env parsers. POSTGRES_CA_PATH wins if
# both are set. Leave empty locally.
POSTGRES_CA_PEM=

# --- Alerts (optional) -----------------------------------------------------
# Any endpoint that accepts a JSON POST: ntfy, a Slack-style hook, your own.
# Without it, alerts go to the log.
NOTIFY_WEBHOOK_URL=

# --- The API and the field kit -------------------------------------------
# The bearer token the field kit sends with every upload. Any long random
# string; the phone asks for it once and keeps it in local storage.
API_TOKEN=
# Address to listen on, and the account captures are attributed to.
API_ADDR=:8080
API_ACCOUNT=field-kit

# Signing secret for session tokens. Required, at least 32 bytes:
#   openssl rand -base64 48
AUTH_SECRET=

# Google sign-in. Optional: without it, email and password still work.
# Create a Web OAuth client at console.cloud.google.com → APIs & Services →
# Credentials, and paste its client ID here.
GOOGLE_CLIENT_ID=

# Browser origins allowed to call this API — the Flutter web client's origin.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5000,http://127.0.0.1:5000

# --- Classification (system 3) -------------------------------------------
# Any OpenAI-compatible endpoint. The client is provider-agnostic; switching
# is a URL, a key and a model id. Two routes are documented because they have
# different trade-offs, not because one is a fallback.
#
# DeepSeek direct — use this if you hold DeepSeek credits. No card needed
# anywhere, and its vision models support structured output:
#   CLASSIFY_BASE_URL=https://api.deepseek.com/v1
#   CLASSIFY_API_KEY=<your DeepSeek key>
#   CLASSIFY_MODEL=<a vision model id from GET /v1/models>
#
# Vercel AI Gateway — one key for ~400 models, which makes comparing them on
# the eval set a config change. Requires a card on file even for free models.
#   CLASSIFY_BASE_URL=https://ai-gateway.vercel.sh/v1
#   CLASSIFY_API_KEY=${VERCEL_AI_GATEWAY_KEY}
#   CLASSIFY_MODEL=alibaba/qwen3.7-flash   ($0.03/MTok, no_training=all)
CLASSIFY_BASE_URL=https://api.deepseek.com/v1
CLASSIFY_API_KEY=
# Verified 1 Oct 2026 against DeepSeek's own API: it serves two models, and
# only `deepseek-flash` can see images — `deepseek-v4-pro` replies "No image
# provided". Its own listing does not say which is which.
CLASSIFY_MODEL=deepseek-flash
# json_schema or json_object. DeepSeek rejects json_schema outright ("This
# response_format type is unavailable now"), so the shape goes in the prompt
# and is validated after parsing. Use json_schema wherever it is supported.
CLASSIFY_SCHEMA_MODE=json_object

# Kept separately so the gateway key survives a provider switch.
VERCEL_AI_GATEWAY_KEY=

# What kind of data this deployment classifies. `own_test_data` permits models
# that train on their inputs; `citizen_photograph` does not, and the refusal
# happens before a request is built (internal/classify/policy.go).
#
# Most cheap vision models report no_training="some" — only some providers
# behind them honour it. That is enough for your own eval photographs and not
# enough for a stranger's face, which is why the two are different settings.
CLASSIFY_DATA_KIND=own_test_data

# --- Mail, password resets and email verification (D171) ------------------
# Three states, and the default is the honest one: with MAIL_MODE unset the
# reset and verification endpoints answer 501 rather than minting a one-time
# credential nobody will ever receive.
#
#   smtp  real mail through any SMTP server. TLS is not optional: a password
#         and a one-time credential do not travel in the clear.
#   log   writes the message, link included, to the log. This is the personal
#         tier's answer (ADR 0017: the only account is the operator's own, and
#         the operator can read their own link). It puts a live credential in
#         the log, so it has to be asked for by name.
#   unset no route; the endpoints refuse.
MAIL_MODE=
MAIL_FROM=
MAIL_FROM_NAME=TraceSarkar
SMTP_HOST=
# Defaults to 587 for starttls and 465 for implicit.
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (the default) or implicit. There is deliberately no "none".
SMTP_TLS=starttls

# Where this service lives. Two uses, and the second is the important one.
#
# It is the base of the link in a reset mail, so it is required whenever
# MAIL_MODE is set and is checked at startup rather than on the first reset
# somebody needs.
#
# It is also the base of every issue permalink — the line a generated post
# tells a reader to follow, burned into the card image and forwarded past any
# page this platform can correct. Without it that link is built from the
# request's `Host` header, and the share kit is a public, unauthenticated GET:
# a request carrying `Host: evil.example` makes the platform generate a post
# saying "every fact above is on this page" above a link to a host the caller
# chose (D177). Set this even before a custom domain exists — the service's
# own URL is a correct answer and closes that.
PUBLIC_BASE_URL=

# --- Share kit rewording (ADR 0021) ---------------------------------------
# Off unless SHARE_POLISH is set. With it off, every generated post is the
# deterministic composition in internal/share, which is always correct and is
# what ADR 0020 shipped.
#
# With it on, a model is given the prose lines of an already-composed post —
# no fact set, no link, no issue id — and returns the same numbered lines
# reworded. Every line that comes back is checked span by span against the
# line that went out (internal/polish.Verify): protected references byte for
# byte, numbers as a multiset, no new @handle, #tag or URL, the right script,
# the tone list, the channel window. A single failure anywhere discards the
# whole candidate and the composed post is served.
#
# There is deliberately no default model. A model chosen by default is a model
# nobody decided on, and the choice has to be a recorded decision. Measure a
# candidate before trusting it:
#   POSTGRES_CA_PATH=$PWD/ca.pem TRACESARKAR_LIVE=1 \
#     go test ./internal/polish/ -run TestLive -v
SHARE_POLISH=
POLISH_BASE_URL=
POLISH_API_KEY=
POLISH_MODEL=
# json_schema or json_object, same provider quirk as CLASSIFY_SCHEMA_MODE.
POLISH_SCHEMA_MODE=json_schema
POLISH_PROMPT=share_polish_v1

# --- Exposure tier (D044) --------------------------------------------------
# personal | flagged | public. Phase 0 is personal, and the ingest runner
# refuses sources the register does not allow at this tier (D045).
TRACESARKAR_TIER=personal

# --- The Flutter client ----------------------------------------------------
# Where the app sends captures. The web build bakes it in at compile time, so
# changing it needs a rebuild, not a redeploy.
API_BASE=https://tracesarkar-api-mlkwom573a-el.a.run.app

# --- Signing the Android release -------------------------------------------
# Only needed to build a release APK. The keystore itself is
# app/android/tracesarkar-release.jks, is not in git, and cannot be
# regenerated: lose it and no update can ever be installed over an existing
# install. Back it up somewhere that is not a laptop.
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
