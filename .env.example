# Phase 0 configuration. Copy to .env and fill in. .env is gitignored; never
# commit real values, and never paste them into an issue or a chat.

# --- Object storage (Cloudflare R2, S3-compatible) -------------------------
# The bucket URL may include the bucket path; the endpoint is derived from it.
R2_BUCKET_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=tracesarkar
R2_ACCESS_KEY=
R2_SECRET_ACCESS_KEY=

# --- Database (PostgreSQL 16; Aiven in Phase 0) ----------------------------
POSTGRESQL_CONNECTION=postgres://user:password@host:port/defaultdb?sslmode=require
# Path to the CA certificate. A relative path is resolved against this file's
# directory. Setting it upgrades the connection to sslmode=verify-full.
POSTGRES_CA_PATH=./ca.pem

# --- Alerts (optional) -----------------------------------------------------
# Any endpoint that accepts a JSON POST: ntfy, a Slack-style hook, your own.
# Without it, alerts go to the log.
NOTIFY_WEBHOOK_URL=

# --- The API and the field kit -------------------------------------------
# The bearer token the field kit sends with every upload. Any long random
# string; the phone asks for it once and keeps it in local storage.
API_TOKEN=
# Address to listen on, and the account captures are attributed to.
API_ADDR=:8080
API_ACCOUNT=field-kit

# Signing secret for session tokens. Required, at least 32 bytes:
#   openssl rand -base64 48
AUTH_SECRET=

# Google sign-in. Optional: without it, email and password still work.
# Create a Web OAuth client at console.cloud.google.com → APIs & Services →
# Credentials, and paste its client ID here.
GOOGLE_CLIENT_ID=

# Browser origins allowed to call this API — the Flutter web client's origin.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5000,http://127.0.0.1:5000

# --- Exposure tier (D044) --------------------------------------------------
# personal | flagged | public. Phase 0 is personal, and the ingest runner
# refuses sources the register does not allow at this tier (D045).
TRACESARKAR_TIER=personal
