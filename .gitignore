# Binaries
bin/
dist/
*.exe
*.dll
*.so
*.dylib
watchdog
tracesarkar

# Go
*.test
*.out
vendor/
go.work.sum

# Environment / secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json
# Google OAuth client files. Only the client_id is needed by this project and
# it lives in .env; the client_secret in these files is not used at all,
# because ID tokens are verified against Google's JWKS rather than exchanged.
client_secret*.json
*.apps.googleusercontent.com.json

# Data — the archive lives in object storage, not git
data/archive/
data/raw/
data/cache/
*.sqlite
*.db
*.dump
*.sql.gz

# Large geo files (use Git LFS or object storage)
*.shp
*.shx
*.dbf
*.gpkg
*.tif
*.tiff

# Node (web client)
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# Python (analysis notebooks)
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs and local state
*.log
tmp/
.tmp/
coverage.*

# Android release signing. The keystore is the app's identity: losing it means
# a new package, and leaking it means someone else can sign as us.
*.jks
*.jks.old
*.keystore
app/android/key.properties
