# The HTTP surface as a container.
#
# Separate from Dockerfile, which builds the collector for the Cloud Run job in
# asia-south1. They are different workloads on different schedules: the
# collector runs twice a day and exits, this one stays up. One image with two
# entrypoints would couple their deploys for no gain.

FROM golang:1.26 AS build
WORKDIR /src

# Dependencies first, so edits to the code do not re-download them.
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/
COPY internal/ ./internal/
# The field kit is embedded with go:embed, so it travels inside the binary.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/api ./cmd/api

# distroless/static carries the CA bundle and nothing else: no shell, no package
# manager, nothing to patch. It also means no curl for a healthcheck, which is
# why the binary answers `api health` itself.
FROM gcr.io/distroless/static-debian12
WORKDIR /app

COPY --from=build /out/api /app/api

EXPOSE 8080
ENTRYPOINT ["/app/api"]
CMD ["serve"]
